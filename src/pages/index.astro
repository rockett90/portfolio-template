---
import Base from '../layouts/Base.astro';
import { site, cv } from '../site.config';
import {
  getContent, inlineBold, cvReady, cvAttrs, builtOn,
  projectTypeLabel, resourceTypeLabel, ventureStatusLabel,
} from '../lib/content';

const { projects, resources, ventures } = await getContent();

const handle = (url: string) => url.replace(/\/+$/, '').split('/').pop();
const consulting = inlineBold(site.consultingNote);
const { credential, headings } = site;

const arrows = {
  read:     '<path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5"/>',
  back:     '<path d="M14 8H3M7.5 3.5 3 8l4.5 4.5"/>',
  open:     '<path d="M4 12 12 4M5.5 4H12v6.5"/>',
  download: '<path d="M8 2v11M3.5 8.5 8 13l4.5-4.5"/>',
};
---
<Base>

  <!-- ── Hero: statement, datasheet, title block ── -->
  <section class="hero">
    <div class="hero-main">
      <h1 class="statement">{site.tagline.split(/(?<=\.)\s+/).map(line => <span class="stmt-line">{line}</span>)}</h1>
      <p class="lead">{site.lead}</p>
    </div>

    <table class="rev">
      <caption>Currently</caption>
      <tbody>
        <tr><th scope="row"><span class="now-dot" aria-hidden="true"></span>Working on</th><td>{site.currently}</td></tr>
      </tbody>
    </table>

    <div class="hero-plate">
      <table class="datasheet">
        <caption>Datasheet</caption>
        <tbody>
          {site.datasheet.map(row => (
            <tr>
              <th scope="row">{row.key}</th>
              <td>{row.value.split(' · ').map((part, i) => <>{i > 0 && ' · '}<span class="ds-part">{part}</span></>)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="titleblock">
        <div class="tb-name">
          <span class="tb-who">{site.name}</span>
          <span class="tb-role">{site.title}</span>
        </div>
        {cvReady
          ? <a class="tb-cell tb-half tb-primary" href={cv.href} {...cvAttrs}>
              <span class="tb-k">CV</span>
              <span class="tb-v">Download PDF
                <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.download} />
              </span>
            </a>
          : <div class="tb-cell tb-half tb-static">
              <span class="tb-k">CV</span><span class="tb-v tb-soon">Coming soon</span>
            </div>}
        <a class:list={['tb-cell tb-half', !cvReady && 'tb-primary']} href={`mailto:${site.email}`}>
          <span class="tb-k">Email</span>
          <span class="tb-v">Send me a message
            <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.read} />
          </span>
        </a>
        <a class="tb-cell tb-half" href={site.linkedin} target="_blank" rel="noopener">
          <span class="tb-k">LinkedIn</span><span class="tb-v">{handle(site.linkedin)}</span>
        </a>
        <a class="tb-cell tb-half" href={site.github} target="_blank" rel="noopener">
          <span class="tb-k">GitHub</span><span class="tb-v">{handle(site.github)}</span>
        </a>
        {site.youtube
          ? <a class="tb-cell tb-half" href={site.youtube} target="_blank" rel="noopener">
              <span class="tb-k">YouTube</span><span class="tb-v">Watch the channel</span>
            </a>
          : <div class="tb-cell tb-half tb-static">
              <span class="tb-k">YouTube</span><span class="tb-v tb-soon">Channel coming soon</span>
            </div>}
        {!credential.value
          ? <div class="tb-cell tb-half tb-static"><span class="tb-k">Site updated</span><span class="tb-v">{builtOn}</span></div>
          : credential.href
            ? <a class="tb-cell tb-half" href={credential.href} target="_blank" rel="noopener">
                <span class="tb-k">{credential.label}</span><span class="tb-v">{credential.value}</span>
              </a>
            : <div class="tb-cell tb-half tb-static"><span class="tb-k">{credential.label}</span><span class="tb-v">{credential.value}</span></div>}
      </div>
    </div>
  </section>

  <!-- ── About ── -->
  <section id="about" class="sec">
    <h2>{headings.about}</h2>
    <div class="about">
      <div class="bio">
        {site.bio.map(para => <p set:html={inlineBold(para)} />)}
      </div>
      <figure class="photo">
        {site.photo
          ? <img src={site.photo} alt={`Photo of ${site.name}`} width="480" height="600" />
          : <div class="photo-empty" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/></svg>
              <span>Photo coming soon</span>
            </div>}
      </figure>
    </div>
  </section>

  <!-- ── Skills ── -->
  <section id="skills" class="sec">
    <h2>{headings.skills}</h2>
    <table class="parts">
      <tbody>
        {site.skills.map(group => (
          <tr>
            <th scope="row">{group.label}</th>
            <td><ul class="parts-items">{group.items.map(item => <li>{item}</li>)}</ul></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- ── Resources ── -->
  <section id="resources" class="sec">
    <div class="rail-head">
      <h2>{headings.resources}</h2>
      <div class="rail-nav">
        <button class="rail-btn" type="button" data-dir="-1" aria-label="Scroll resources back"><svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.back} /></button>
        <button class="rail-btn" type="button" data-dir="1" aria-label="Scroll resources forward"><svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.read} /></button>
      </div>
    </div>
    <div class="rail-wrap">
      <ul class="rail" tabindex="0" aria-label="Resources">
        {resources.map(r => {
          const link = r.data.file
            ? { href: `/files/${r.data.file}`, verb: 'Download', icon: arrows.download, attrs: { download: true } }
            : r.data.url
              ? { href: r.data.url, verb: 'Open', icon: arrows.open, attrs: { target: '_blank', rel: 'noopener' } }
              : { href: `/resources/${r.id}`, verb: 'Read', icon: arrows.read, attrs: {} };
          return (
            <li class="tile">
              <p class="tile-top"><span>{resourceTypeLabel[r.data.type]}</span><span>{r.data.updated}</span></p>
              <h3 class="tile-title"><a class="tile-link" href={link.href} {...link.attrs}>{r.data.title}</a></h3>
              <p class="tile-desc">{r.data.description}</p>
              <p class="tile-tags">{r.data.tags.join(', ')}</p>
              <p class="tile-go">{link.verb} <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={link.icon} /></p>
            </li>
          );
        })}
        {resources.length === 0 && (
          <li class="tile tile-soon">
            <p class="tile-top"><span>Coming soon</span></p>
            <h3 class="tile-title">Templates and guides on the way</h3>
            <p class="tile-desc">Things worth sharing land here as they're ready.</p>
          </li>
        )}
        {(resources.length ? [1] : [1, 2, 3]).map(() => <li class="tile tile-slot" aria-hidden="true"></li>)}
      </ul>
    </div>
    <div class="rail-foot" aria-hidden="true">
      <span class="rail-count"></span>
      <span class="rail-track"><span class="rail-thumb"></span></span>
    </div>
  </section>

  <!-- ── Projects ── -->
  <section id="projects" class="sec">
    <div class="rail-head">
      <h2>{headings.projects}</h2>
      <div class="rail-nav">
        <button class="rail-btn" type="button" data-dir="-1" aria-label="Scroll projects back"><svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.back} /></button>
        <button class="rail-btn" type="button" data-dir="1" aria-label="Scroll projects forward"><svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.read} /></button>
      </div>
    </div>
    <div class="rail-wrap">
      <ul class="rail" tabindex="0" aria-label="Projects">
        {projects.map(p => (
          <li class="tile">
            <p class="tile-top"><span>{projectTypeLabel[p.data.type]}</span><span>{p.data.status ?? p.data.date}</span></p>
            <h3 class="tile-title"><a class="tile-link" href={`/projects/${p.id}`}>{p.data.title}</a></h3>
            <p class="tile-desc">{p.data.description}</p>
            <p class="tile-tags">{p.data.tags.join(', ')}</p>
            <p class="tile-go">Read <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.read} /></p>
          </li>
        ))}
        {projects.length === 0 && (
          <li class="tile tile-soon">
            <p class="tile-top"><span>Coming soon</span></p>
            <h3 class="tile-title">Build write-ups on the way</h3>
            <p class="tile-desc">Projects land here as they reach a shareable state.</p>
          </li>
        )}
        {(projects.length ? [1] : [1, 2, 3]).map(() => <li class="tile tile-slot" aria-hidden="true"></li>)}
      </ul>
    </div>
    <div class="rail-foot" aria-hidden="true">
      <span class="rail-count"></span>
      <span class="rail-track"><span class="rail-thumb"></span></span>
    </div>
  </section>

  <!-- ── Ventures ── -->
  <section id="ventures" class="sec">
    <div class="rail-head">
      <h2>{headings.ventures}</h2>
      <div class="rail-nav">
        <button class="rail-btn" type="button" data-dir="-1" aria-label="Scroll ventures back"><svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.back} /></button>
        <button class="rail-btn" type="button" data-dir="1" aria-label="Scroll ventures forward"><svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.read} /></button>
      </div>
    </div>
    <div class="rail-wrap">
      <ul class="rail" tabindex="0" aria-label="Ventures">
        {ventures.map(v => (
          <li class="tile">
            <div class="venture-head">
              <div class="venture-mark">
                {v.data.logo ? <img src={v.data.logo} alt="" /> : v.data.name.slice(0, 2).toUpperCase()}
              </div>
              <p class="tile-top"><span>{ventureStatusLabel[v.data.status]}</span></p>
            </div>
            <h3 class="tile-title">
              {v.data.url ? <a class="tile-link" href={v.data.url} target="_blank" rel="noopener">{v.data.name}</a> : v.data.name}
            </h3>
            <p class="tile-desc">{v.data.tagline}</p>
            {v.data.url && <p class="tile-go">Visit site <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.open} /></p>}
          </li>
        ))}
        {ventures.length === 0 && (
          <li class="tile tile-soon">
            <p class="tile-top"><span>Coming soon</span></p>
            <h3 class="tile-title">Something's in the works</h3>
            <p class="tile-desc">Details to follow when it's ready to share.</p>
          </li>
        )}
        {(ventures.length ? [1] : [1, 2, 3]).map(() => <li class="tile tile-slot" aria-hidden="true"></li>)}
      </ul>
    </div>
    <div class="rail-foot" aria-hidden="true">
      <span class="rail-count"></span>
      <span class="rail-track"><span class="rail-thumb"></span></span>
    </div>
  </section>

  <!-- ── Close: consulting ── -->
  <section class="close">
    <p class="close-note" set:html={consulting} />
    <a class="close-mail" href={`mailto:${site.email}`}>
      Get in touch
      <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" set:html={arrows.read} />
    </a>
  </section>

</Base>
