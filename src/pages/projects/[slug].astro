---
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../site.config';
import { projectTypeLabel, readingMinutes, routable } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', routable);
  return projects.map(p => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;

const links = [
  d.repo    && { href: d.repo,    label: 'GitHub repo' },
  d.youtube && { href: d.youtube, label: 'Watch on YouTube' },
].filter(Boolean) as { href: string; label: string }[];
---
<Base title={`${d.title} — ${site.name}`} description={d.description}>
  <Article
    back={{ href: '/#projects', label: 'Back to projects' }}
    title={d.title}
    description={d.description}
    tags={d.tags}
    meta={[
      projectTypeLabel[d.type],
      d.date,
      ...(d.status ? [d.status] : []),
      `${readingMinutes(project.body)} min read`,
    ]}
    links={links}
    headings={headings}
    draft={d.draft}
  >
    <Content />
  </Article>
</Base>
