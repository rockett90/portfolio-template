---
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../site.config';
import { resourceTypeLabel, readingMinutes, routable } from '../../lib/content';

export async function getStaticPaths() {
  // Only resources without a file *and* without an external url get a page.
  const resources = await getCollection('resources', e => routable(e) && !e.data.file && !e.data.url);
  return resources.map(r => ({ params: { slug: r.id }, props: { resource: r } }));
}

const { resource } = Astro.props;
const { Content, headings } = await render(resource);
const d = resource.data;
---
<Base title={`${d.title} — ${site.name}`} description={d.description}>
  <Article
    back={{ href: '/#resources', label: 'Back to resources' }}
    title={d.title}
    description={d.description}
    tags={d.tags}
    meta={[
      resourceTypeLabel[d.type],
      `Updated ${d.updated}`,
      `${readingMinutes(resource.body)} min read`,
    ]}
    headings={headings}
    draft={d.draft}
  >
    <Content />
  </Article>
</Base>
