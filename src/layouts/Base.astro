---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { site, cv } from '../site.config';
import { sections, cvReady, cvAttrs } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.metaTitle,
  description = site.metaDescription,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage   = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f7f0ee" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161012" media="(prefers-color-scheme: dark)" />

  <!-- Set theme before first paint to avoid a flash of the wrong theme. -->
  <script is:inline>
    (() => {
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch {}
      const sys = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', saved || sys);
    })();
  </script>
</head>
<body>
  <div class="sheet">

    <!-- ── Zone band: the drawing's top border, and the nav ── -->
    <header class="band">
      <a class="band-name" href="/">{site.name}</a>
      <nav class="band-zones" aria-label="Sections">
        {sections.map(s => (
          <a class="zone" href={`/#${s.id}`}>{s.label}</a>
        ))}
        {cvReady && <a class="zone" href={cv.href} {...cvAttrs}>CV</a>}
      </nav>
      <button class="zone zone-theme" id="themeToggle" type="button" aria-label="Switch colour theme">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        <span class="t-to-dark">Dark</span><span class="t-to-light">Light</span>
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-row">
        <span>{site.name} · {site.title}</span>
        <span class="foot-links">
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          {site.youtube && <a href={site.youtube} target="_blank" rel="noopener">YouTube</a>}
          <a href={`mailto:${site.email}`}>Email</a>
          {cvReady && <a href={cv.href} {...cvAttrs}>CV</a>}
        </span>
      </div>
    </footer>

  </div>

  <script>
    // ── Theme toggle (initial theme is set inline in <head>) ──
    const root = document.documentElement;
    document.getElementById('themeToggle')?.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch {}
    });

    // ── Rails: native horizontal scroll, plus buttons for mouse users ──
    // The buttons and track are always shown, so a rail reads as scrollable
    // even before it has enough tiles to overflow.
    document.querySelectorAll<HTMLElement>('.rail').forEach(rail => {
      const sec = rail.closest('section');
      const nav = sec?.querySelector<HTMLElement>('.rail-nav');
      const wrap = rail.parentElement!;
      const thumb = sec?.querySelector<HTMLElement>('.rail-thumb');
      const count = sec?.querySelector<HTMLElement>('.rail-count');
      if (!nav) return;
      const [prev, next] = nav.querySelectorAll<HTMLButtonElement>('.rail-btn');
      const real = rail.querySelectorAll('.tile:not(.tile-soon):not(.tile-slot)').length;
      const noun = (rail.getAttribute('aria-label') ?? '').toLowerCase();
      const update = () => {
        const max = rail.scrollWidth - rail.clientWidth;
        prev.disabled = rail.scrollLeft <= 4;
        next.disabled = rail.scrollLeft >= max - 4;
        wrap.classList.toggle('more-right', rail.scrollLeft < max - 4);
        wrap.classList.toggle('more-left', rail.scrollLeft > 4);
        if (thumb) {
          thumb.style.width = `${(rail.clientWidth / rail.scrollWidth) * 100}%`;
          thumb.style.transform = `translateX(${(rail.scrollLeft / rail.clientWidth) * 100}%)`;
        }
        if (count) count.textContent = real ? `${real} ${real === 1 ? noun.replace(/s$/, '') : noun}` : 'More soon';
      };
      nav.querySelectorAll<HTMLButtonElement>('.rail-btn').forEach(btn =>
        btn.addEventListener('click', () =>
          rail.scrollBy({ left: Number(btn.dataset.dir) * rail.clientWidth * 0.8, behavior: 'smooth' })));
      rail.addEventListener('scroll', update, { passive: true });
      new ResizeObserver(update).observe(rail);
      update();
    });

    // ── Active section on scroll ──
    const zones = document.querySelectorAll<HTMLAnchorElement>('.band-zones a[href^="/#"]');
    const byId = new Map<string, HTMLAnchorElement>();
    zones.forEach(a => byId.set(a.getAttribute('href')!.slice(2), a));
    const sections = [...byId.keys()].map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    if (sections.length) {
      const io = new IntersectionObserver(entries => {
        const hit = entries
          .filter(e => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!hit) return;
        zones.forEach(a => a.removeAttribute('aria-current'));
        byId.get(hit.target.id)?.setAttribute('aria-current', 'true');
      }, { rootMargin: '-40% 0px -55% 0px' });
      sections.forEach(s => io.observe(s));
    }
  </script>
</body>
</html>
